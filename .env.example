# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/rebook_ai?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Email (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Rebook AI <noreply@yourdomain.com>"

# Webhook signing secret (shared with booking system)
REBOOK_WEBHOOK_SECRET="change-me"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Rebook AI"