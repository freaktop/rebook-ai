generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  bookingUrl       String?
  reminderInterval Int      @default(21)
  brandingColor    String?  @default("#2563eb")
  contactEmail     String?
  contactPhone     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  admins           BusinessAdmin[]
  customers        Customer[]
  appointments     Appointment[]
  reminderConfigs  ReminderConfig[]
  reminderJobs     ReminderJob[]
  deliveries       ReminderDelivery[]
  webhookEvents    WebhookEvent[]
  auditLogs        AuditLog[]
}

model BusinessAdmin {
  id           String   @id @default(cuid())
  businessId   String
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Customer {
  id           String   @id @default(cuid())
  businessId   String
  externalId   String?
  email        String
  firstName    String?
  lastName     String?
  phone        String?
  optedOut     Boolean  @default(false)
  optedOutAt   DateTime?
  consentGiven Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  preferences  CustomerPreference?
  reminderJobs ReminderJob[]
  deliveries   ReminderDelivery[]
  unsubscribes UnsubscribeRecord[]

  @@unique([businessId, email])
  @@index([businessId])
  @@index([businessId, optedOut])
}

model CustomerPreference {
  id             String   @id @default(cuid())
  customerId     String   @unique
  emailEnabled   Boolean  @default(true)
  smsEnabled     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Appointment {
  id              String   @id @default(cuid())
  businessId      String
  customerId      String
  externalId      String?
  serviceId       String?
  serviceName     String?
  status          String   @default("completed")
  completedAt     DateTime?
  bookingUrl      String?
  idempotencyKey  String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reminderJobs    ReminderJob[]

  @@index([businessId])
  @@index([businessId, customerId])
  @@index([businessId, status])
}

model ReminderConfig {
  id             String   @id @default(cuid())
  businessId     String
  intervalDays   Int      @default(21)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId])
}

model ReminderJob {
  id             String   @id @default(cuid())
  businessId     String
  customerId     String
  appointmentId  String
  scheduledFor   DateTime
  status         String   @default("pending")
  canceledReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  deliveries     ReminderDelivery[]

  @@index([businessId, status])
  @@index([scheduledFor, status])
  @@unique([appointmentId])
}

model ReminderDelivery {
  id            String   @id @default(cuid())
  businessId    String
  customerId    String
  reminderJobId String
  status        String   @default("pending")
  providerId    String?
  error         String?
  sentAt        DateTime?
  createdAt     DateTime @default(now())

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reminderJob   ReminderJob @relation(fields: [reminderJobId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

model UnsubscribeRecord {
  id          String   @id @default(cuid())
  customerId  String
  token       String   @unique
  reason      String?
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model WebhookEvent {
  id            String   @id @default(cuid())
  businessId    String?
  source        String
  eventType     String
  idempotencyKey String  @unique
  payload       Json
  status        String   @default("received")
  error         String?
  createdAt     DateTime @default(now())
  processedAt   DateTime?

  business      Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([source, eventType])
}

model AuditLog {
  id          String   @id @default(cuid())
  businessId  String?
  actor       String?
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  business    Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
}